DATABASE_URL=postgresql://user:password@host:5432/database
NAS_HOST=nas.example.local
NAS_USER=replace_me
NAS_PASS=replace_me
NAS_DIR=/predict
# A NAS_DIR alatti betegmappák gyökere.
NAS_PATIENTS_DIR=patients

# Legalább 32 véletlen karakter; a munkamenetek aláírására szolgál.
SECRET_KEY=replace_with_a_long_random_value

# A klinikai utánkövetési munkafelület külön hozzáférési kódja.
FOLLOWUP_ACCESS_CODE=replace_with_a_strong_access_code

# A szakértői prior-felmérés hozzáférési kódja (a szakértőknek adható ki; betegadatot nem nyit meg).
# Ha üresen marad, a felmérés kód nélkül, a link ismeretében kitölthető.
EXPERT_ACCESS_CODE=replace_with_a_separate_access_code

# A Blender addon és a szerver közös titka.
BLENDER_API_KEY=replace_with_a_long_random_value

# A Blenderből archiválható .blend fájl maximális mérete MB-ban.
BLEND_UPLOAD_MAX_MB=1024

# Hosszú .blend feltöltéseknél a Gunicorn ne állítsa le idő előtt a workert.
GUNICORN_TIMEOUT=1800

# Opcionális etalon betegazonosító; ne kerüljön verziókövetésbe valós értékkel.
REFERENCE_TAJ=

# Szakértői meghívók e-mailben, SMTP-n. Ugyanazok a változók, mint a ShadeMatch
# és a maxillofaciális alkalmazás Render-beállításaiban (SMTP_PASS és SMTP_FROM,
# illetve SMTP_FROM_NAME és SMTP_REPLY_TO is elfogadott). SendGrid esetén:
# SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey,
# SMTP_PASSWORD=<SendGrid API-kulcs>; a feladó címe a SendGridben igazolt küldő.
# A konigfogaszat-minta is működik: elég a SENDGRID_API_KEY (vagy SendGridAPI_Key)
# és a feladó (SMTP_FROM), a relay adatai ilyenkor automatikusak.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
SENDGRID_API_KEY=
SMTP_SENDER_EMAIL=predict@example.org
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM_NAME=PREDICT-vizsgálat
EXPERT_MAIL_REPLY_TO=
# A levél aláírása; a sortörést \n jelöli (a Render nem értelmezi, az alkalmazás alakítja át).
# Ha üres, a feladó neve kerül a levél aljára.
EXPERT_MAIL_SIGNATURE=Dr. König János\nSemmelweis Egyetem, Fogpótlástani Klinika\nPREDICT-vizsgálat\nkonig.janos@semmelweis.hu
# A levelekbe és a meghívó-linkekbe kerülő állandó cím (Renderen kötelező, különben
# az admin oldal hosztja, pl. taf-hcax.onrender.com kerülne a linkekbe).
APP_BASE_URL=https://predict-study.hu
